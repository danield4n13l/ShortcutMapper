{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "group": "test",
            "label": "Start Five Server",
            "type": "shell",
            "command": "echo",
            "args": ["${input:ext-fs-start}"]
        },
        {
            "group": "test",
            "label": "Stop Five Server",
            "type": "shell",
            "command": "echo",
            "args": ["${input:ext-fs-stop}"]
        }
    ],
    "inputs": [
        {
            "id": "ext-fs-start",
            "type": "command",
            "command": "fiveServer.start"
        },
        {
            "id": "ext-fs-stop",
            "type": "command",
            "command": "fiveServer.close"
        }
    ]
}