{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "promptOnClose": true,
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "label": "Start http-server",
            "type": "shell",
            "command": "node",
            "args": [
                "./node_modules/http-server/bin/http-server",
                "-p",
                "${input:portnum}",
                "-c-1"
            ],
            "isBackground": true,
            "icon": {
                "id": "server"
            },
            "runOptions": {
                "instanceLimit": 1,
                "instancePolicy": "warn",
                "runOn": "folderOpen"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": {
                "owner": "http-server",
                "pattern": [
                    {
                        "regexp": "^Error: (Cannot find module) \\'(.+)\\'",
                        "kind": "file",
                        "file": 1,
                        "message": 0,
                        "severity": 1
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting up http-server, serving (.+)$",
                    "endsPattern": "http-server stopped\\."
                }
            }
        }
    ],
    "inputs": [
        {
            "id": "portnum",
            "type": "promptString",
            "description": "Enter the port number to start the server on",
            "default": "8080"
        }
    ]
}