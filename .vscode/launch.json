{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "content/javascripts/**/*.js"
            ],
            "perScriptSourcemaps": "auto",
            "disableNetworkCache": true,
            "includeLaunchArgs": true,
            "name": "Launch Chrome with Five Server",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Five Server",
            "postDebugTask": "Stop Five Server",
            "runtimeArgs": [
                "--enable-features=DevToolsWellKnown,DevToolsAutomaticFileSystems"
            ]
        },
        {
            "type": "chrome",
            "request": "launch",
            "sourceMaps": true,
            "outFiles": [
                "content/**/*.js"
            ],
            "perScriptSourcemaps": "auto",
            "disableNetworkCache": true,
            "includeLaunchArgs": true,
            "name": "Launch Chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}",
            "runtimeArgs": [
                "--enable-features=DevToolsWellKnown,DevToolsAutomaticFileSystems",
                "--remote-debugging-pipe",
                "--auto-open-devtools-for-tabs",
                "--debug-on-start"
            ]
        }
    ]
}